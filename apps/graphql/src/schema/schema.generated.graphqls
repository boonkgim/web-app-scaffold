type Mutation {
  """
  Sends the verification template to an address on MAIL_TEST_RECIPIENTS.
  Exists to prove the mail pipeline in production; not part of any feature.
  """
  sendTestEmail(to: String!): Boolean!
}

type Query {
  appEnv: String!
  health: String!
  version: String!
  viewer: Viewer
}

type Viewer {
  email: String!
  id: ID!
}
