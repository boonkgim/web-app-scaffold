{
  "name": "@cc4-test/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "preview": "NEXT_PUBLIC_APP_ENV=preview opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:production": "NEXT_PUBLIC_APP_ENV=production opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --env-file .env.production",
    "codegen": "pnpm run cf-typegen && pnpm run codegen:graphql",
    "cf-typegen": "next typegen && wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "codegen:graphql": "graphql-codegen"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.0",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "catalog:",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "catalog:",
    "eslint-config-next": "16.3.4",
    "graphql": "^17.0.2",
    "tailwindcss": "^4",
    "typescript": "catalog:",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "type": "module"
}
