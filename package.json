  "main": "index.js",
  "scripts": {
    "test": "turbo run test",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "format:changed": "git diff --name-only --diff-filter=ACMR HEAD | xargs -r prettier --write --ignore-unknown --cache",
    "docs:check": "node scripts/docs-check.mjs",
    "verify": "pnpm format:changed && pnpm docs:check && turbo run lint typecheck test:unit --filter=\"...[HEAD]\""
  },
